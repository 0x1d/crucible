{
  "name": "elixir-harness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Alchemist host-independent Elixir capability codex",
  "scripts": {
    "check": "npm run check:types && npm run check:docs",
    "check:types": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "test:check-docs": "node --test scripts/check-docs.test.mjs",
    "dev": "agent-sdk dev --dir hosts/cursor",
    "chat:claude": "node hosts/claude/chat.ts",
    "eval:claude": "node --test hosts/claude/evals/*.eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "@grok/agent-sdk": "^0.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  }
}
