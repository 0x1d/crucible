{
  "name": "elixir-harness",
  "private": true,
  "type": "module",
  "description": "Alchemist host-independent Elixir capability registry",
  "scripts": {
    "check": "npm run check:types && npm run check:docs",
    "check:types": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "test:check-docs": "node --test scripts/check-docs.test.mjs",
    "dev": "agent-sdk dev"
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.2.29",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  }
}
