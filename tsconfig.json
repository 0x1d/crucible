{
  // Type-checking only (npm run check): the framework runs hosts/cursor/bot/ code
  // directly through tsx, so nothing is compiled.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["core/**/*", "hosts/**/*", "tui/**/*"]
}
